#!/bin/bash
# .husky/vibe-coding-standards-gate — vibe-coding-standards L1 行数弹性 Gate (2026-08-19 NEW)
#
# 触发时机: git commit(由 .husky/pre-commit step 9 调用)/ 手动 `bash .husky/vibe-coding-standards-gate`
# 门禁项:
#   1. 行数弹性检查: 所有 skill-markets/<x>/SKILL.md + AGENTS.md + agents/*.md 必须落 100~350 区间
#      (vibe-coding-standards v2.5 阈值 — 引用 skill-markets/vibe-coding-standards/SKILL.md)
#   2. 只对 staged 修改过的 skill 触发(优化 pre-commit 性能)
#
# 跨平台 Python 探测: 复用 scripts/detect-python.sh(详见 AGENTS.md §4.1.3)

# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/detect-python.sh" || exit 1
PY="$MY_TRAE_HELPER_PY"

# PowerShell 调 bash 子进程时, stdout 句柄可能被父进程 pipe 截断
exec 1>&2
set -e

echo "🔍 执行 vibe-coding-standards L1 行数弹性 Gate (PY=$PY)..."

# 收集此次 commit 修改过的 skill 目录(只有改了的才需要扫)
CHANGED_SKILL_DIRS=$(git diff --name-only --cached 2>/dev/null | awk -F/ '/^skill-markets\/[^/]+\// {print $2}' | sort -u)

if [ -z "$CHANGED_SKILL_DIRS" ]; then
    echo "ℹ️  本次 commit 未触及任何 skill 目录,跳过 vibe-line 检查"
    echo "✅ vibe-coding-standards L1 Gate 通过(无变更)"
    exit 0
fi

echo "📋 扫描变更的 skill ($(echo $CHANGED_SKILL_DIRS | wc -w) 个): $CHANGED_SKILL_DIRS"

errors_total=0
warnings_total=0

for skill in $CHANGED_SKILL_DIRS; do
    skill_dir="skill-markets/$skill"
    if [ ! -d "$skill_dir" ]; then
        # 文件可能只在子文件层变(不是 SKILL.md),仍扫以防漏
        skill_dir=$(echo "$CHANGED_SKILL_DIRS" | head -1 | xargs -I {} echo "skill-markets/{}")
        if [ ! -d "$skill_dir" ]; then continue; fi
    fi

    echo ""
    echo "  ▶ $PY scripts/vibe-coding-standards-line-guard.py $skill"
    # _guard_lib 输出 JSON + 人类提示 + 退出码(0=PASS, 1=BLOCK)
    if ! "$PY" scripts/vibe-coding-standards-line-guard.py "$skill_dir"; then
        errors_total=$((errors_total + 1))
    fi
done

echo ""
if [ "$errors_total" -gt 0 ]; then
    echo "❌ vibe-coding-standards L1 Gate BLOCK: $errors_total 个 skill 行数超阈值"
    echo "   修复指引:把超量内容提取到 skill-markets/$skill/references/ 目录"
    echo "   详见:skill-markets/vibe-coding-standards/SKILL.md §体积弹性范围"
    exit 1
fi

echo "✅ vibe-coding-standards L1 Gate 通过($warnings_total 个 skill 有 warning,仅记录不阻断)"
