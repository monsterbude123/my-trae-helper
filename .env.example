# ── doc-map-manager ChromaDB Embedding 配置 ──
# 复制为 .env 并修改（.env 已被 gitignore）

# 方案 1：本地 CPU 模型（默认，零外部依赖）
DOCMAP_EMBEDDING_PROVIDER=sentence_transformers
DOCMAP_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 方案 2：OpenAI 兼容端点（ollama / vllm / LM Studio / text-embeddings-inference）
# DOCMAP_EMBEDDING_PROVIDER=openai
# DOCMAP_EMBEDDING_API_BASE=http://localhost:11434/v1
# DOCMAP_EMBEDDING_API_KEY=ollama
# DOCMAP_EMBEDDING_MODEL=bge-small-zh-v1.5

# 方案 3：Chromadb 自带轻量模型（英文为主，无需下载）
# DOCMAP_EMBEDDING_PROVIDER=chroma_default

# 并发数（仅 OpenAI 模式生效，默认 10）
# DOCMAP_CONCURRENCY=20

# 额外文档分析目录（分号分隔，支持绝对或相对路径）
# 用于引入外部技能市场、参考文档等作为文档检索源
# DOCMAP_EXTRA_DOCS_DIRS=./skill-markets/other-pkg/docs;D:\shared-docs
