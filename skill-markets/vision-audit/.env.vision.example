# Vision Audit — Qwen3-VL 视觉模型配置
# 复制为 .env.vision 并填入你的 local llm 部署信息
# 技能目录: .trae/skills/vision-audit/
#
# 脚本会自动搜索以下位置的 .env.vision:
#   1. <project_root>/.env.vision
#   2. .trae/skills/vision-audit/.env.vision
#   3. <cwd>/.env.vision

# local llm 本地服务地址（默认 localhost:1234）
VISION_API_BASE_URL=http://localhost:1234/v1

# 模型名称（在 local llm 中加载的模型标识符）
# 推荐: Qwen3-VL-8B-Instruct (GGUF)
# 临时: Qwen3-VL-4B-Instruct 或 qwen3-vl-4b-thinking (GGUF)
VISION_MODEL_NAME=qwen3-vl-8b-instruct

# API Key（local llm 本地部署可为任意值，但必填）
VISION_API_KEY=lm-studio

# 请求超时（毫秒），单张截图分析约 5-15 秒
VISION_REQUEST_TIMEOUT=30000

# 最大并发请求数（避免 GPU OOM）
# 4B thinking 模型建议 1，8B instruct 模型可用 2
VISION_MAX_CONCURRENCY=2

# Worker 交错启动间隔（毫秒），避免瞬时负载冲击
# 当 maxConcurrency > 1 时，每个 worker 启动相隔此延迟
VISION_WORKER_START_DELAY=500

# 失败请求最大重试次数（超时/5xx 自动重试，4xx 不重试）
VISION_MAX_RETRIES=2

# 重试基础间隔（毫秒），指数退避：delay * 2^attempt
VISION_RETRY_DELAY_MS=2000

# 截图目录（相对于项目根目录）
VISION_SCREENSHOTS_DIR=frontend/debug/screenshots

# 输出报告目录（相对于项目根目录）
VISION_REPORT_DIR=frontend/debug/reports/vision
