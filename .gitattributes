# V11.8.0 NEW — 仓库级 .gitattributes(2026-08-15)
# 修复 AGENTS.md §4.1.3 跨平台铁律:Git Hook 必须跨平台探测,不硬编码路径
# 强制 shell 脚本 / Python 脚本 / Git 钩子保持 LF,避免 Git pull 后 Windows CRLF 破坏 bash 执行

# 默认 LF
* text=auto eol=lf

# Shell 脚本 — 必须 LF
*.sh            text eol=lf
.gitattributes  text eol=lf

# Git 钩子(无扩展名)— 必须 LF
/.husky/*       text eol=lf

# Python / Node / YAML / Markdown — LF(统一)
*.py            text eol=lf
*.mjs           text eol=lf
*.js            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# 二进制 / Windows 特定 — 保持原样
*.png           binary
*.jpg           binary
*.gif           binary
*.ico           binary
*.pdf           binary