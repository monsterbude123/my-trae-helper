#!/bin/bash
# .husky/quality-documentation-manager-gate — quality-documentation-manager L1 Commit Gate (2026-08-21 NEW)
#
# 触发时机: git commit (由 .husky/pre-commit 调用) / 手动 `bash .husky/quality-documentation-manager-gate`
# 门禁项:
#   1. quality-documentation-manager 结构守卫(项目侧 scripts/quality-documentation-manager-guard.py)
#      - SKILL.md 存在 + frontmatter 合规(name/description)
#      - SKILL.md 行数 100~350 弹性范围内
#   2. 仅在改动 skill-markets/quality-documentation-manager/ 时触发
#   3. 仅 guard-smith agent 可改本文件 + scripts/quality-documentation-manager-guard.py(AGENTS.md §1.11)
#
# 跨平台 Python 探测: 复用 scripts/detect-python.sh(详见 AGENTS.md §4.1.3)

# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/detect-python.sh" || exit 1
PY="$MY_TRAE_HELPER_PY"

# PowerShell 调 bash 子进程时, stdout 句柄可能被父进程 pipe 截断
exec 1>&2
set -e

echo "🔍 执行 quality-documentation-manager L1 Gate (PY=$PY)..."

# 探测是否触及 quality-documentation-manager 相关文件
CHANGED=$(git diff --name-only --cached 2>/dev/null | grep -E '^skill-markets/quality-documentation-manager/' || true)
if [ -z "$CHANGED" ]; then
    echo "ℹ️  本次 commit 未触及 quality-documentation-manager 相关文件,跳过守卫"
    echo "✅ quality-documentation-manager L1 Gate 通过(无变更)"
    exit 0
fi

echo "📋 改动文件 ($(echo "$CHANGED" | wc -l) 项):"
echo "$CHANGED" | sed 's/^/  - /'

# 跑专属守卫
echo ""
echo "  ▶ $PY scripts/quality-documentation-manager-guard.py skill-markets/quality-documentation-manager"
"$PY" scripts/quality-documentation-manager-guard.py skill-markets/quality-documentation-manager || EXIT_CODE=$?

if [ "${EXIT_CODE:-0}" = "1" ]; then
    echo ""
    echo "❌ quality-documentation-manager L1 Gate BLOCK"
    echo "   修复指引:"
    echo "     - 确认 SKILL.md 存在 + YAML frontmatter 含 name/description 字段"
    echo "     - 确认 SKILL.md 行数在 100~350 弹性范围内"
    exit 1
fi

echo ""
echo "✅ quality-documentation-manager L1 Gate 通过"
