#!/bin/bash
# Skill Market L1 Commit Gate
#
# 触发时机: git commit
# 检查项:
#   - Lint
#   - TypeCheck
#   - Unit Tests
#   - 技能安全守卫（仅变更的技能）
#   - 技能结构守卫（仅新建技能）

set -e

echo "🔍 执行 L1 Commit Gate..."

# 1. Lint
if command -v npm &> /dev/null && grep -q '"lint"' package.json; then
  echo "1️⃣ 执行 Lint..."
  npm run lint
fi

# 2. TypeCheck
if command -v npm &> /dev/null && grep -q '"typecheck"' package.json; then
  echo "2️⃣ 执行 TypeCheck..."
  npm run typecheck
fi

# 3. Unit Tests
if command -v npm &> /dev/null && grep -q '"test:unit"' package.json; then
  echo "3️⃣ 执行 Unit Tests..."
  npm run test:unit
fi

# 4. 技能安全守卫（仅变更的技能）
# 取 skill-markets/<dir>/<file> 中 <dir> 部分,排除 .md 单文件(如 CAPABILITY-MAP.md)
CHANGED_SKILLS=$(git diff --name-only --cached | grep '^skill-markets/' | awk -F/ '$2 && $2 !~ /\.md$/ {print $2}' | sort -u)
if [ -n "$CHANGED_SKILLS" ]; then
  echo "4️⃣ 执行技能安全守卫..."
  for skill in $CHANGED_SKILLS; do
    if [ -d "skill-markets/$skill" ]; then
      echo "  - 检查 $skill..."
      python scripts/skill-security-guard.py "skill-markets/$skill" || {
        echo "❌ 安全守卫失败: $skill"
        exit 1
      }
    fi
  done
fi

# 5. 技能结构守卫（仅新建技能）
# 只匹配 skill-markets/<dir>/SKILL.md,排除 CAPABILITY-MAP.md 等单文件
NEW_SKILLS=$(git diff --name-only --cached --diff-filter=A | grep '^skill-markets/[^/]*/SKILL\.md$' | awk -F/ '{print $2}' | sort -u)
if [ -n "$NEW_SKILLS" ]; then
  echo "5️⃣ 执行技能结构守卫..."
  for skill in $NEW_SKILLS; do
    if [ -d "skill-markets/$skill" ]; then
      echo "  - 检查 $skill..."
      python scripts/skill-structure-guard.py "skill-markets/$skill" || {
        echo "❌ 结构守卫失败: $skill"
        exit 1
      }
    fi
  done
fi

echo "✅ L1 Commit Gate 通过"