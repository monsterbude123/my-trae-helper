#!/bin/bash
# Skill Market L2 Push Gate
#
# 触发时机: git push
# 检查项（必须全部执行,失败即阻断）:
#   - Integration Tests
#   - Coverage Tests
#   - 技能依赖守卫（全部技能）
#   - Skill Bundle 守卫
#   - Build（验证 CLI 配置）

# 跨平台 Python 探测: 与 .husky/pre-commit 一致(共享 scripts/detect-python.sh)
# pre-push 是独立进程,不继承 pre-commit 的 $PY,必须自己探测

# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/detect-python.sh" || exit 1
PY="$MY_TRAE_HELPER_PY"

set -e

echo "🔍 执行 L2 Push Gate (PY=$PY)..."

# 0. 注册表守卫（与 L1 一致 — push 也要拦截,防 --no-verify 绕过）
echo "0️⃣ 注册表守卫..."
node src/guards/skill-registration-guard.mjs

# 1. Integration Tests（必须存在）
if ! grep -q '"test:integration"' package.json; then
  echo "❌ Gate 配置错误: package.json 缺少 test:integration 脚本"
  exit 1
fi
echo "1️⃣ Integration Tests..."
npm run test:integration

# 2. Coverage（必须存在）
if ! grep -q '"test:coverage"' package.json; then
  echo "❌ Gate 配置错误: package.json 缺少 test:coverage 脚本"
  exit 1
fi
echo "2️⃣ Coverage..."
npm run test:coverage

# 3. 技能依赖守卫（全部技能目录）
if [ -d "skill-markets" ]; then
  echo "3️⃣ 技能依赖守卫..."
  for skill in skill-markets/*/; do
    skill_name=$(basename "$skill")
    if [ -f "$skill/SKILL.md" ]; then
      node src/guards/skill-dependency-guard.mjs "$skill_name" || {
        echo "❌ 依赖检查失败: $skill_name"
        exit 1
      }
    fi
  done
fi

# 3.5 Skill Bundle 守卫(all mode,全量 — skill-bundle/SKILL.md §Guard L2)
if [ -d "skill-markets" ]; then
  echo "3.5️⃣ Skill Bundle 守卫 (all mode,全量扫全部父包)..."
  "$PY" skill-markets/skill-acceptance/checks/07_bundle_structure.py --mode all || {
    echo "❌ Skill Bundle 守卫 BLOCK,见上方 BND-001~006"
    exit 1
  }
fi

# 4. Build（必须存在）
if ! grep -q '"build"' package.json; then
  echo "❌ Gate 配置错误: package.json 缺少 build 脚本"
  exit 1
fi
echo "4️⃣ Build..."
npm run build

# 5. catalog-guard(只跑变更的 skill — 全量跑留给 L3 CI)
PUSH_SKILLS=$(git diff --name-only @{push}..HEAD 2>/dev/null | grep '^skill-markets/' | awk -F/ '$2 {print $2}' | sort -u)
if echo "$PUSH_SKILLS" | grep -q "agent-dev-control-kit"; then
  echo "5️⃣ agent-dev-control-kit catalog-guard (L2) ..."
  python scripts/run-agent-dev-control-kit-tests.py
fi

# 5. 保护路径守卫(change-guard-approver gate) — 阻断未审批的 Tier 2/3 修改
echo "5️⃣ 保护路径守卫(gate,要求所有 Tier 2/3 修改已 resolve)..."
node scripts/change-guard-approver.mjs gate || {
  echo "❌ push gate BLOCK — 有保护路径变更未审批或被拒绝"
  exit 1
}

echo "✅ L2 Push Gate 通过"