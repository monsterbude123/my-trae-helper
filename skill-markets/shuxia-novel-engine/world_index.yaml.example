          - "涉及资质/灵根判定"
          - "涉及角色能力量化"
      dependencies: [constitution, physics-foundation, energy-system]

    - id: combat-quantification
      path: "创作正文/世界观/战斗与突破量化.md"
      title: "战斗与突破量化"
      category: "战斗系统"
      description: "战力指数公式/境界压制系数S(N)/伤害公式ATK×G_eff×S×(1+Crit)−DEF/战斗消耗率/陆之一绝灵近身机制/AI盲区/天劫量化/PVP-PVE"
      sections:
        - range: "§2-§4"
          layer: "protocol"
        - range: "§1,§5-§7"
          layer: "session"
      load_on:
        agents: [scene_composer, plot_orchestrator, consistency_auditor]
        phases: [P2, P3, P4]
        conditions:
