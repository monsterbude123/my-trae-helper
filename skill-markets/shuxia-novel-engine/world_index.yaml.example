      title: "技能树架构"
      category: "技能树"
      description: "【已废弃】原始技能树文件。上篇→玄黄界修真体系.md，下篇→赛博修真科技树.md。本文档仅作历史索引。"
      load_on:
        agents: []
        phases: []
        conditions: []
      dependencies: []
      deprecated_aliases: []
      meta:
        deprecates: "创作正文/世界观/技能树架构.md"
        superseded_by: [traditional-cultivation-system, cyber-cultivation-tech-tree]

  # ═══════════════════════════════════════════
  # 会话层 (Session) — "怎么用"
  # 叙事应用。角色行为、技能释放、社会互动。创作时查询"这件事怎么做"的层。
  # ═══════════════════════════════════════════
  session:
    - id: faction-reputation
      path: "创作正文/世界观/宗门声望体系.md"
      title: "宗门声望体系"
      category: "势力"
      description: "双域声望(绝灵之地:学术+灰色+官方 vs 玄黄界:修为+贡献+势力)/声望提升方式/万象宗监控机制(声望=监控伪装)/贡献度消耗=暴露需求"
      load_on:
        agents: [scene_composer, plot_orchestrator]
        phases: [P2, P3]
        conditions:
          - "涉及角色在宗门/势力中的声望变化"
          - "涉及万象宗监控机制"
      dependencies: [faction-map, character-schema]

    - id: character-design-principles
      path: "创作正文/世界观/角色塑造原则.md"
      title: "角色塑造原则"
      category: "角色"
      description: "层次光谱(表层→中层→深层→核心)/六阶段身份转变(怀疑者→编译者→逃亡者→伪装者→手艺人→逃亡领袖→理念播种者)/角色禁止事项表/弧线检查规则(Δ≤1级必须有触发事件)"
      load_on:
        agents: [plot_orchestrator, scene_composer, creative_director]
        phases: [P1, P3]
        conditions:
          - "涉及角色弧线设计"
          - "涉及新角色创建/现有角色发展方向调整"
      dependencies: [character-schema]

    - id: social-satire-scenes
      path: "创作正文/世界观/社会讽刺场景库.md"
      title: "社会讽刺场景库"
      category: "叙事素材"
      description: "现实社会黑暗面→修真界场景映射：灵脉庞氏骗局/散修炼丹血汗工厂/妖兽角斗场/灵根检测=科举+种姓制/灵石矿工灵毒症/功法版本降级=计划淘汰等"
      load_on:
        agents: [scene_composer, plot_orchestrator]
        phases: [P2, P3]
        conditions:
          - "涉及社会讽刺/修真界黑暗面描写"
          - "涉及万象宗体系弊病揭示"
      dependencies: [faction-map, social-class-matrix]

    - id: social-class-matrix
      path: "创作正文/世界观/社会阶层穿越矩阵.md"
      title: "社会阶层穿越矩阵"
      category: "叙事素材"
      description: "6个缺失阶层(玄黄界凡人/修真底层劳工/修真中产/修真精英/修真统治层/跨界者)/每阶层含进入方式+社会讽刺映射+代表角色建议+对主角认知影响"
      load_on:
        agents: [scene_composer, plot_orchestrator]
        phases: [P2, P3]
        conditions:
          - "涉及新阶层角色引入"
          - "涉及社会结构/阶级矛盾描写"
      dependencies: [faction-map, social-satire-scenes]

  # ═══════════════════════════════════════════
  # 元文档 (Meta) — 索引/集成类，不直接参与叙事
  # ═══════════════════════════════════════════
  meta_documents:
    - id: four-layer-index
      path: "创作正文/世界观/亚文化四层索引.md"
      title: "亚文化四层索引"
      category: "元文档"
      description: "四层架构导航中枢。人类可读的四层文档映射视图。由 world_index.yaml 驱动更新。"
      meta:
        is_meta: true

    - id: subculture-overview
      path: "创作正文/世界观/亚文化定义全貌.md"
      title: "亚文化定义全貌"
      category: "元文档"
      description: "集成百科。按四层组织20+份文档的完整摘要。与四层索引互补(索引=导航地图，本文档=集成百科)。"
      meta:
        is_meta: true

# ═══════════════════════════════════════════
# 跨层查询模板
# 从亚文化四层索引提取的典型纵向追溯路径。
# AI 遇到类似问题时，沿 chain 列表逐层查询。
# ═══════════════════════════════════════════
cross_layer_queries:
  - name: "飞剑为什么越来越慢"
    description: "从飞剑速度公式追溯到底层灵压衰退"
    chain:
      - "session.equipment-quantification"
      - "representation.equipment-quantification"
      - "protocol.energy-system"
      - "foundation.physics-foundation"

  - name: "严峰为什么在绝灵之地修为倒退"
    description: "从角色行为追溯到底层负灵压区"
    chain:
      - "session.faction-reputation"
      - "representation.cultivation-biology"
      - "protocol.energy-system"
      - "foundation.world-design"

  - name: "真气vs灵力vs灵气的区别"
    description: "同层横向对比——三者都是灵子流但相干度不同"
    chain:
      - "session.energy-system"
      - "representation.energy-system"
      - "protocol.energy-system"
      - "foundation.energy-system"

  - name: "万象宗功法篡改的物理机制"
    description: "从叙事问题追溯到底层物理和版本降级公理"
    chain:
      - "session.traditional-cultivation-system"
      - "representation.traditional-cultivation-system"
      - "protocol.cultivation-biology"
      - "foundation.constitution"

  - name: "陆之一灵能电池的完整创新链"
    description: "从战术装置追溯到底层理论和工程原理"
    chain:
      - "session.cyber-cultivation-tech-tree"
      - "representation.cyber-cultivation-tech-tree"
      - "protocol.ling-energy-engineering"
      - "foundation.energy-system"

  - name: "丹药为什么越来越难炼"
    description: "从丹药品阶追溯到底层灵植灭绝和灵压衰退"
    chain:
      - "session.pill-resource-quantification"
      - "representation.pill-resource-quantification"
      - "protocol.hundred-arts-protocol"
      - "foundation.world-design"

# ═══════════════════════════════════════════════════════════════
# 导出到 PlotPilot 亚文化包
# ==============================================================
# 使用 export_subculture_package.py 将此索引 + 文档导出为
# PlotPilot 可消费的 .zip 亚文化包。
#
# PlotPilot 是独立的开源小说写作工具，支持上传自定义世界观包。
# 我们作为内容生产者，对接其 "亚文化包格式" (manifest.yaml)。
#
# 导出命令:
#   python skill-novel-engine/scripts/export_subculture_package.py \
#     --name "万古余烬" \
#     --version "1.0" \
#     --author "作者名" \
#     --description "硬核赛博修仙世界观" \
#     --compatible-genres xianxia,xuanhuan \
#     --output ./万古余烬_v1.0.zip
#
# ═══════════════════════════════════════════════════════════════
# Category 映射表 (world_index → PlotPilot manifest)
# ─────────────────────────────────────────────────
#   skill-novel-engine        →  PlotPilot manifest key
#   公理体系                    →  meta
#   物理底层                    →  physics
#   能量转换                    →  physics
#   境界体系                    →  physics
#   战斗系统                    →  technique
#   装备系统                    →  technique
#   资源经济                    →  economy
#   地理                        →  geography
#   势力                        →  faction
#   技能树                      →  technique
#   角色                        →  character
#   叙事素材                    →  culture
#   映射参考                    →  meta
#   元文档 (is_meta: true)      →  不导出
#
# ═══════════════════════════════════════════════════════════════
# load_triggers 设计指南
# ─────────────────────
# load_on.conditions 会被转换为 PlotPilot 的 load_triggers:
#   "涉及战斗场景"           →  触发词: "战斗"
#   "涉及境界突破/寿元计算"  →  触发词: "境界突破","寿元"
#   "涉及丹药/灵材描写"      →  触发词: "丹药","灵材"
#
# 规则:
#   - 公理体系、映射参考类的文档 → load_triggers: ["*"] (始终注入)
#   - 其他文档 → 从 conditions 提取关键词
#   - 已废弃文档 (meta.deprecates) → 不导出
#   - 元文档 (meta.is_meta) → 不导出
#
# ═══════════════════════════════════════════════════════════════
# 版本兼容性
# ──────────
# PlotPilot 亚文化包格式版本: 1.0
# 数据契约: PlotPilot manifest.yaml Specification
# 兼容范围: PlotPilot >= 当前版本
# 升级策略: world_index.yaml Schema 变更时，export 脚本同步更新映射逻辑
