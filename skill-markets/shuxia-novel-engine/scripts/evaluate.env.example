# ── evaluate.py 环境变量覆盖 ──
# 复制为 evaluate.env 后修改。所有字段可选，未设置则用内置默认值。

# 章节规划根目录（相对项目根 OR 绝对路径）
# EVAL_CHAPTER_ROOT=创作正文/章节规划

# 结构化配置文件路径（JSON，相对项目根 OR 绝对路径）
# EVAL_CONFIG_PATH=skill-novel-engine/scripts/evaluate_config.json

# ── 等级阈值 ──
# EVAL_GRADE_S=95
# EVAL_GRADE_A=85
# EVAL_GRADE_B=75
# EVAL_GRADE_C=65
# 低于 C = D

# ── CONDITIONAL 判定 ──
# 权重 ≥ 此值的维度得分低于 low_score 时标记为 CONDITIONAL
# EVAL_LOW_DIM_WEIGHT=0.10
# EVAL_LOW_DIM_SCORE=70

# ── 量化密度期望（per 百字）──
# EVAL_QUANT_DENSITY_COMBAT=2.0
# EVAL_QUANT_DENSITY_DRAMA=1.0
# EVAL_QUANT_DENSITY_REVEAL=1.5
# EVAL_QUANT_DENSITY_TRANSITION=1.2

# ── 自定义量化参数正则（覆盖 config.json 中的 quant_regex）──
# EVAL_QUANT_REGEX=\d+\.?\d*\s*(?:息|米|秒|分钟|小时|天|年|Hz|kHz|MHz|dB|kW|W|%|倍)

# ── 输出 ──
# 设为 1 时禁用 Unicode 进度条（用于终端不支持 █░ 的环境）
# EVAL_NO_UNICODE_BAR=0