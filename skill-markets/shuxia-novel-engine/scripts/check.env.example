# ── check.py 环境变量覆盖 ──
# 复制为 check.env 后修改。所有字段可选。

# 扫描根目录（相对项目根 OR 绝对路径）
# CHECK_SCAN_ROOT=创作正文

# 排除目录（逗号分隔）
# CHECK_EXCLUDE_DIRS=归档,__pycache__,.git

# 排除文件模式（逗号分隔）
# CHECK_EXCLUDE_FILES=concept_graph*,S60*,S61*

# ── 评分阈值 ──
# CHECK_PASS_THRESHOLD=85
# CHECK_CONDITIONAL_THRESHOLD=60

# ── 严重度权重 ──
# CHECK_TERM_PENALTY=1
# CHECK_DEPRECATED_PENALTY=2
# CHECK_CONSTITUTIONAL_PENALTY=10
# CHECK_METHOD_VIOLATION_PENALTY=8

# ── 宪法文档路径（相对项目根）
# CHECK_CONSTITUTION_PATH=创作正文/世界观/亚文化建设宪法.md

# ── 概念注册表路径（相对项目根）
# CHECK_REGISTRY_PATH=创作正文/状态/S10_概念注册表.yaml
