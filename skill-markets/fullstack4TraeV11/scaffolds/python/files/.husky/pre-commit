#!/usr/bin/env bash
# Pre-commit gate for Python V11 preset (L1 -> Stage 1 Spec)
# Runs ruff + mypy + pytest + validates Stage 1 Spec completeness.
# HARD REQUIREMENT: required tools/scripts MUST exist or be declared — no silent skipping allowed.

set -euo pipefail

REQUIRED_TOOLS=("ruff" "mypy" "pytest")
REQUIRED_FILES=("pyproject.toml" "docs/specs/.state-card.md")
FAILURES=0

cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "==> [L1 -> Stage 1 Spec] Running pre-commit gate (python V11 preset)..."

# ---- Step 1: project file existence check ----
echo "    [1/?] Project manifest existence check:"
MISSING_FILES=()
for f in "${REQUIRED_FILES[@]}"; do
  if [ -f "$f" ]; then
    echo "          [$f] ✓ exists"
  else
    echo "          [$f] ✗ MISSING — gate fails"
    MISSING_FILES+=("$f")
    FAILURES=$((FAILURES + 1))
  fi
done

# ---- Step 2: tool existence check ----
echo ""
echo "    [2/?] Required tool existence check:"
MISSING_TOOLS=()
for tool in "${REQUIRED_TOOLS[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then
    echo "          [$tool] ✓ installed ($(command -v "$tool"))"
  else
    echo "          [$tool] ✗ NOT INSTALLED — gate fails"
    MISSING_TOOLS+=("$tool")
    FAILURES=$((FAILURES + 1))
  fi
done

# ---- Step 3: state-card validation (Stage 1 Spec) ----
if [ -f docs/specs/.state-card.md ]; then
  echo ""
  echo "    [3/?] State card validation:"
  if grep -q 'current_stage.*1-spec' docs/specs/.state-card.md 2>/dev/null; then
    echo "          ✓ current_stage = 1-spec"
  else
    current=$(grep 'current_stage' docs/specs/.state-card.md 2>/dev/null | head -1 || echo "unknown")
    echo "          ⚠ current_stage not at 1-spec: $current"
    echo "          (This is a warning, not a blocker)"
  fi
fi

# ---- Step 4: pyproject.toml placeholder check ----
if [ -f pyproject.toml ]; then
  echo ""
  echo "    [4/?] pyproject.toml placeholder scan:"
  if grep -qiE 'skip[[:space:]]*[:=][[:space:]]*true|^[[:space:]]*#[[:space:]]*noqa[[:space:]]*$' pyproject.toml; then
    echo "          ⚠️  Found suspicious skip markers in pyproject.toml"
  fi
fi

if [ $FAILURES -gt 0 ]; then
  echo ""
  echo "    🛑 Gate FAIL: ${FAILURES} required item(s) missing"
  if [ ${#MISSING_FILES[@]} -gt 0 ]; then
    echo "        Missing files:"
    for s in "${MISSING_FILES[@]}"; do echo "          - $s"; done
  fi
  if [ ${#MISSING_TOOLS[@]} -gt 0 ]; then
    echo "        Missing tools:"
    for s in "${MISSING_TOOLS[@]}"; do echo "          - $s"; done
    echo ""
    echo "    Install all required tools:"
    echo "        pip install -e '.[dev]'"
    echo "    Or:  pip install ruff mypy pytest pytest-cov"
  fi
  exit "$FAILURES"
fi

# ---- Step 5: real execution ----
run_step() {
  local label="$1"
  shift
  echo ""
  echo "    [$label] $*"
  if "$@"; then
    echo "    [$label] ✓ PASS"
  else
    echo "    [$label] ✗ FAIL"
    FAILURES=$((FAILURES + 1))
  fi
}

run_step "5/7" "ruff" check .
run_step "6/7" "mypy" src/
run_step "7/7" "pytest" tests/unit -v

if [ $FAILURES -gt 0 ]; then
  echo ""
  echo "==> [L1] FAILED ($FAILURES check(s) failed)"
  exit "$FAILURES"
fi

# ---- Step 6: update state-card gate_result ----
if [ -n "$STATE_CARD" ]; then
  sed -i 's/gate_result:.*/gate_result: PASS/' "$STATE_CARD" 2>/dev/null || true
fi

echo ""
echo "==> [L1 -> Stage 1 Spec] PASSED"