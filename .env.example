# ── doc-map-manager ChromaDB Embedding 配置 ──
# 复制为 .env 并修改（.env 已被 gitignore）

# 方案 1：本地 CPU 模型（默认，零外部依赖）
DOCMAP_EMBEDDING_PROVIDER=sentence_transformers
DOCMAP_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 方案 2：OpenAI 兼容端点（ollama / vllm / LM Studio / text-embeddings-inference）
# DOCMAP_EMBEDDING_PROVIDER=openai
# DOCMAP_EMBEDDING_API_BASE=http://localhost:11434/v1
# DOCMAP_EMBEDDING_API_KEY=ollama
# DOCMAP_EMBEDDING_MODEL=bge-small-zh-v1.5

# 方案 3：Chromadb 自带轻量模型（英文为主，无需下载）
# DOCMAP_EMBEDDING_PROVIDER=chroma_default

# 并发数（仅 OpenAI 模式生效，默认 10）
# DOCMAP_CONCURRENCY=20

# 额外文档分析目录（分号分隔，支持绝对或相对路径）
# 用于引入外部技能市场、参考文档等作为文档检索源
# DOCMAP_EXTRA_DOCS_DIRS=./skill-markets/other-pkg/docs;D:\shared-docs


# =========================================
# publish CLI — 环境配置模板
# =========================================
# 复制此文件为 .env，按下面注释填写真实值。
# 真正运行时会通过 `publish config dns` 和 `publish config ssh` 引导输入，
# 这些值最终存到 ~/.publish/config.yaml。
# 本文件仅作参考和文档化用途，不会被代码自动加载。
# =========================================

# ── 1. DNS 提供商（必填） ─────────────────
# 三个值任选其一：cloudflare / aliyun / dnspod
# 注意：你选择哪个，下面对应提供商的字段才需要填
DNS_PROVIDER=aliyun

# ── 2A. 阿里云 DNS（如果 DNS_PROVIDER=aliyun） ──
# 获取方式：
#   1. https://ram.console.aliyun.com → 用户 → 创建用户 → 编程访问
#   2. 勾选"Open API 调用访问"，创建后立即复制保存（Secret 仅显示一次）
#   3. 给用户授权策略：AliyunDNSFullAccess
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 你要发布子域名的"主域"，例如发布 app.example.com 就填 example.com
ALIYUN_DOMAIN=

# ── 2B. Cloudflare DNS（如果 DNS_PROVIDER=cloudflare） ──
# 获取方式：
#   1. https://dash.cloudflare.com → My Profile → API Tokens
#   2. Create Token → "Edit zone DNS" 模板 → Zone Resources 选域名
#   3. Zone ID 在域名 Overview 页面右下角 API 段
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# ── 2C. DNSPod（如果 DNS_PROVIDER=dnspod） ──
# 获取方式：
#   1. https://console.dnspod.cn → 账号中心 → API 密钥管理 → 创建密钥
DNSPOD_SECRET_ID=
DNSPOD_SECRET_KEY=
DNSPOD_DOMAIN=

# ── 3. SSH 连接到云机器（必填） ─────────
# 你的云机器公网 IP 或域名
SSH_HOST=

# SSH 用户名（通常是 root 或 ubuntu）
SSH_USER=root

# SSH 端口（默认 22）
SSH_PORT=22

# SSH 认证 — 密钥或密码二选一
# 私钥路径（推荐），例如 ~/.ssh/id_rsa
SSH_KEY_PATH=
# 密码认证（不推荐，密钥更安全）
SSH_PASSWORD=

# ── 4. 部署时常用参数（可选） ───────────
# 是否默认申请 SSL 证书（deploy --ssl/--no-ssl）
DEFAULT_ENABLE_SSL=true

# 每次 deploy 最多保留的备份版本数（VR-007 默认 5）
MAX_BACKUPS=5
