# world_index.yaml.example — 世界观文档动态索引模板
# ============================================
# 用途：为 subculture-novel-engine Skill 提供机器可读的世界观文档索引。
#       AI 通过此文件发现、定位、按需加载世界观文档。
#       四层架构：底层(Foundation) → 协议(Protocol) → 表示(Representation) → 会话(Session)
#
# 使用方式：
#   1. 复制此文件到项目根目录，命名为 world_index.yaml
#   2. 运行 python skill-novel-engine/scripts/init_world_index.py 自动填充
#   3. 手动编辑需同步的用户自定义字段（description/load_on.conditions）
#   4. 新增文档后重新运行初始化脚本做增量更新
#
# Schema 字段说明：
#   _note: 元数据注释字段，不被脚本解析
#   id: 唯一标识符（kebab-case），用于 dependencies 引用
#   path: 文档路径（相对于项目根目录）
#   title: 文档标题（从文件第一个 # 行提取）
#   category: 分类标签（公理体系/能量转换/物理底层/境界体系/战斗系统/装备系统/资源经济/地理/势力/技能树/角色/叙事素材/经济/映射参考）
#   description: 一句话描述文档内容
#   sections: 跨层文档的章节→层级映射（可选）
#   load_on: 加载触发规则
#     agents: 哪些 Agent 需要加载此文档
#     phases: 哪些门禁阶段需要加载（P0-P4）
#     conditions: 叙事条件触发（自然语言描述，AI 语义匹配）
#   dependencies: 前置依赖文档的 id 列表（加载本文档前需先加载依赖）
#   auto_classified: 是否由脚本自动推断层级（true=待人工审核）
#   deprecated_aliases: 废弃别名列表
#   meta: 附加元数据
#     split_from: 拆分来源文档路径
#     deprecates: 废弃的源文档路径
#     is_meta: 是否为元文档（索引/集成类）
#
# 层级分配规则（供 init_world_index.py 关键词推断使用）：
#   foundation:  灵子/自旋/Klein-Gordon/灵压/灵导率/BEC/公理/常数/宇宙/星球
#   protocol:    转换/耦合/退相干/阻抗/压制公式/伤害公式/消耗率/信仰之力
#   representation: 分类/品阶/矩阵/列表/境界/资质/势力/地图/古籍/对照表
#   session:     应用/场景/操作/修炼/战斗/炼丹/炼器/声望/角色/叙事/创新/讽刺
# ============================================

meta:
  _note: "索引元数据"
  generated_at: "2026-06-18T00:00:00"
  total_documents: 28
  index_version: "1.0"
  content_root: "创作正文/世界观/"
  skill_version: "2.0"

layers:
  # ═══════════════════════════════════════════
  # 底层 (Foundation) — "为什么存在"
  # 物理公理。不可更改。任何上层设定与此冲突时以此层为准。
  # ═══════════════════════════════════════════
  foundation:
    - id: constitution
      path: "创作正文/世界观/亚文化建设宪法.md"
      title: "亚文化建设宪法"
      category: "公理体系"
      description: "7条不可变公理：双重物理轨道/灵压单向衰退/灵子=L场量子/版本降级/绝灵之体/小真协处理器/创新范式"
      load_on:
        agents: [world_architect, consistency_auditor, creative_director]
        phases: [P0, P4]
        conditions: []
      dependencies: []
      deprecated_aliases: []

    - id: physics-foundation
      path: "创作正文/世界观/修真物理学.md"
      title: "修真物理学"
      category: "物理底层"
      description: "灵子(spin-0, m~10⁻³eV)/Klein-Gordon方程/灵场Maxwell方程/灵导率σ_L/灵动力学/精神力学/灵魂理论/时空论/道论"
      sections:
        - range: "§1-§2"
          layer: "foundation"
        - range: "§3-§6"
          layer: "protocol"
      load_on:
        agents: [world_architect, scene_composer, consistency_auditor]
        phases: [P0, P3, P4]
        conditions:
          - "涉及灵场物理计算"
          - "涉及灵魂/神识/时空描写"
      dependencies: [constitution]

    - id: world-design
      path: "创作正文/世界观/底层设计.md"
      title: "底层设计"
      category: "物理底层"
      description: "宇宙时间线(大爆炸→稀灵纪元→绝灵时代)/玄黄星参数(1000×地球)/九大灵枢/双重物理轨道/天地夺灵大阵三缺陷/元会历纪年/绝灵之地双重纪年/11000年历史空洞"
      sections:
        - range: "§1-§2"
          layer: "foundation"
        - range: "§8"
          layer: "representation"
      load_on:
        agents: [world_architect, plot_orchestrator, scene_composer]
        phases: [P0, P1, P3]
        conditions:
          - "涉及时间线/历史事件"
          - "涉及绝灵之地物理环境"
          - "涉及天地夺灵大阵机制"
      dependencies: [constitution, physics-foundation]

    - id: energy-system
      path: "创作正文/世界观/能源形态体系.md"
      title: "能源形态体系"
      category: "能量转换"
      description: "灵子基态(气)/物质基态(精)/信息基态(神)/Klein-Gordon/BEC/相干度ξ/退相干速率γ/27种能量形态全矩阵/L↔EM耦合/生物灵场耦合/集体意识耦合/灵压梯度驱动"
      sections:
        - range: "§0-§1"
          layer: "foundation"
        - range: "§2"
          layer: "protocol"
        - range: "§3"
          layer: "representation"
        - range: "§4"
          layer: "session"
      load_on:
        agents: [world_architect, scene_composer]
        phases: [P0, P3]
        conditions:
          - "涉及能量转换/战斗消耗描写"
          - "涉及境界突破/灵力运转描写"
      dependencies: [constitution, physics-foundation]

  # ═══════════════════════════════════════════
  # 协议层 (Protocol) — "怎么转换"
  # 能量/信息/物质之间的转换规则。定义了什么是"可能的"。
  # ═══════════════════════════════════════════
  protocol:
    - id: cultivation-biology
      path: "创作正文/世界观/修真生物学与境界学.md"
      title: "修真生物学与境界学"
      category: "境界体系"
      description: "八境寿元阶梯(凡人→合道归真)/人生阶段模型(%已耗寿元)/B0-B6肉体等级/W0-W7意识层次/资质七维(根骨/灵慧/灵根/神识/炼器/炼丹/特殊)/灵根谐振频率分布"
      sections:
        - range: "§1-§3"
          layer: "protocol"
        - range: "§4"
          layer: "representation"
      load_on:
        agents: [world_architect, plot_orchestrator, scene_composer]
        phases: [P0, P1, P3]
        conditions:
