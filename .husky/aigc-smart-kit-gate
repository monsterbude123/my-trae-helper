#!/bin/bash
# .husky/aigc-smart-kit-gate — aigc-smart-kit L1 Commit Gate (2026-08-20 NEW)
#
# 触发时机: git commit (由 .husky/pre-commit 调用) / 手动 `bash .husky/aigc-smart-kit-gate`
# 门禁项:
#   1. aigc-smart-kit 结构/子 skill/脚本/密钥/JSON schema 6 项检查
#   2. 仅对 staged 修改过的 aigc-smart-kit 触发(优化 pre-commit 性能)
#   3. 仅 guard-smith agent 可改本文件 + scripts/aigc-smart-kit-guard.py(AGENTS.md §1.11)
#
# 跨平台 Python 探测: 复用 scripts/detect-python.sh(详见 AGENTS.md §4.1.3)
#                    不硬编码任何具体路径,只信 PATH + 能力校验

# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/detect-python.sh" || exit 1
PY="$MY_TRAE_HELPER_PY"

# PowerShell 调 bash 子进程时, stdout 句柄可能被父进程 pipe 截断
exec 1>&2
set -e

echo "🔍 执行 aigc-smart-kit L1 Gate (PY=$PY)..."

# 探测是否触及 aigc-smart-kit 相关文件 — 仅在改动时才跑守卫,避免无意义开销
CHANGED=$(git diff --name-only --cached 2>/dev/null | grep -E '^skill-markets/aigc-smart-kit/' || true)
if [ -z "$CHANGED" ]; then
    echo "ℹ️  本次 commit 未触及 aigc-smart-kit 相关文件,跳过守卫"
    echo "✅ aigc-smart-kit L1 Gate 通过(无变更)"
    exit 0
fi

echo "📋 改动文件 ($(echo "$CHANGED" | wc -l) 项):"
echo "$CHANGED" | sed 's/^/  - /'

# 跑专属守卫(本仓内 SKILL 包,非 meta skill)
echo ""
echo "  ▶ $PY scripts/aigc-smart-kit-guard.py skill-markets/aigc-smart-kit"
if ! "$PY" scripts/aigc-smart-kit-guard.py skill-markets/aigc-smart-kit; then
    echo ""
    echo "❌ aigc-smart-kit L1 Gate BLOCK:守卫返回非 0"
    echo "   修复指引:"
    echo "     - 顶层 SKILL.md 行数超 350:提取 references/ 子目录(vibe-coding-standards v2.5)"
    echo "     - 子 skill 缺 SKILL.md:补全 skills/<sub>/SKILL.md(含 frontmatter)"
    echo "     - 顶层 script 缺 docstring / 语法错:补 docstring + 修语法"
    echo "     - 硬编码密钥:替换为环境变量(\$API_KEY / os.environ['API_KEY'])"
    echo "     - image-schema.md 缺失:从原项目复制或新建 ≥200 字符的 schema 定义"
    exit 1
fi

echo ""
echo "✅ aigc-smart-kit L1 Gate 通过"