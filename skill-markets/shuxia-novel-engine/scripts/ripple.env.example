# ── ripple.py 环境变量覆盖 ──
# 复制为 ripple.env 后修改。所有字段可选。

# 概念注册表路径（相对项目根）
# RIPPLE_REGISTRY_PATH=创作正文/状态/S10_概念注册表.yaml

# BFS 最大跳数
# RIPPLE_MAX_HOPS=4

# ── 严重度判定阈值 ──
# 关联概念数 >= 此值时升级为 HIGH
# RIPPLE_HIGH_RELATED_THRESHOLD=3

# MEDIUM 输出上限（超出截断）
# RIPPLE_MEDIUM_DISPLAY_LIMIT=10

# 骨架目录（相对项目根）
# RIPPLE_SKELETON_DIR=创作正文/剧情
