#!/usr/bin/env bash
# Pre-push gate for Node.js V11 preset (L2 -> Stage 3.5 Real Verify)
# Runs integration tests + coverage + build + validates Stage 3.5 consistency.
# HARD REQUIREMENT: required scripts MUST exist in package.json — no echo-skipping allowed.

set -euo pipefail

REQUIRED_SCRIPTS=("test:integration" "test:coverage" "build")
REQUIRED_FILES=("package.json" "docs/specs/.state-card.md")
FAILURES=0

cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

echo "==> [L2 -> Stage 3.5 Real Verify] Running pre-push gate (nodejs V11 preset)..."

# ---- Step 1: existence check (fail-fast) ----
echo "    [1/?] Required file existence check:"
MISSING_FILES=()
for f in "${REQUIRED_FILES[@]}"; do
  if [ -f "$f" ]; then
    echo "          [$f] ✓ exists"
  else
    echo "          [$f] ✗ MISSING — gate fails"
    MISSING_FILES+=("$f")
    FAILURES=$((FAILURES + 1))
  fi
done

if [ ! -f package.json ]; then
  echo ""
  echo "    🛑 Cannot continue without package.json"
  exit 1
fi

# ---- Step 2: required script existence check ----
has_script() {
  local name="$1"
  python3 - "$name" <<'PYEOF' 2>/dev/null
import json, sys
try:
    with open('package.json', 'r', encoding='utf-8') as f:
        data = json.load(f)
    scripts = (data.get('scripts') or {})
    name = sys.argv[1]
    sys.exit(0 if name in scripts else 1)
except Exception:
    sys.exit(1)
PYEOF
}

echo ""
echo "    [2/?] Required script existence check:"
MISSING=()
for script in "${REQUIRED_SCRIPTS[@]}"; do
  if has_script "$script"; then
    body=$(python3 -c "import json; print(json.load(open('package.json')).get('scripts',{}).get('$script',''))" 2>/dev/null)
    if echo "$body" | grep -qiE '^[[:space:]]*echo[[:space:]]+["'"'"']?(skip|not|skipp)'; then
      echo "          [$script] ✗ ECHO-SKIP DETECTED — gate rejects placeholder"
      MISSING+=("$script")
      FAILURES=$((FAILURES + 1))
    else
      echo "          [$script] ✓ script exists"
    fi
  else
    echo "          [$script] ✗ MISSING — gate fails"
    MISSING+=("$script")
    FAILURES=$((FAILURES + 1))
  fi
done

# ---- Step 3: state-card validation (Stage 3.5 Verify) ----
STATE_CARD=$(find docs/specs -name '.state-card.md' 2>/dev/null | head -1)
if [ -n "$STATE_CARD" ]; then
  echo ""
  echo "    [3/?] State card validation:"
  current=$(grep 'current_stage' "$STATE_CARD" 2>/dev/null | head -1 || echo "unknown")
  echo "          Current stage: $current"
  if echo "$current" | grep -qE '3\.5-verify|3-implement|4-review'; then
    echo "          ✓ Stage is at or beyond 3.5-verify"
  else
    echo "          ⚠ Stage is before 3.5-verify — ensure implementation is complete"
    echo "          (This is a warning, not a blocker)"
  fi
fi

# ---- Step 4: spec-impl consistency check ----
echo ""
echo "    [4/?] Spec-Impl consistency check:"
spec_count=$(find docs/specs -name "*.md" -not -name ".state-card.md" 2>/dev/null | wc -l || echo 0)
if [ "$spec_count" -gt 0 ]; then
  echo "          ✓ Found $spec_count spec file(s)"
else
  echo "          ⚠ No spec files found in docs/specs/"
fi

if [ $FAILURES -gt 0 ]; then
  echo ""
  echo "    🛑 Gate FAIL: ${FAILURES} required item(s) missing or invalid"
  if [ ${#MISSING_FILES[@]} -gt 0 ]; then
    echo "        Missing files:"
    for s in "${MISSING_FILES[@]}"; do echo "          - $s"; done
  fi
  if [ ${#MISSING[@]} -gt 0 ]; then
    echo "        Missing/invalid scripts:"
    for s in "${MISSING[@]}"; do echo "          - $s"; done
    echo ""
    echo "    Fix: add real implementation to package.json 'scripts'."
    echo "    Forbidden: 'echo \"skipping ...\"' placeholders."
  fi
  exit "$FAILURES"
fi

# ---- Step 5: real execution ----
run_step() {
  local label="$1"
  local script="$2"
  echo ""
  echo "    [$label] npm run $script"
  if npm run "$script"; then
    echo "    [$label] ✓ PASS"
  else
    echo "    [$label] ✗ FAIL"
    FAILURES=$((FAILURES + 1))
  fi
}

run_step "5/7" "test:integration"
run_step "6/7" "test:coverage"
run_step "7/7" "build"

if [ $FAILURES -gt 0 ]; then
  echo ""
  echo "==> [L2] FAILED ($FAILURES check(s) failed)"
  exit "$FAILURES"
fi

# ---- Step 6: update state-card gate_result ----
if [ -n "$STATE_CARD" ]; then
  sed -i 's/gate_result:.*/gate_result: PASS/' "$STATE_CARD" 2>/dev/null || true
fi

echo ""
echo "==> [L2 -> Stage 3.5 Real Verify] PASSED"