# MyModelScope 本地模型管理配置
# 放置位置：模型仓库根目录（如 D:\ai-models\.mymodelscope.env）
# 或用户家目录（%USERPROFILE%\.mymodelscope.env）

# 模型仓库根目录（所有分类子目录的父级）
MYMODELSCOPE_REPO_PATH=D:\ai-models

# 冷库路径（废弃/归档模型的存放位置）
MYMODELSCOPE_COLD_STORAGE=D:\ai-models\_archive

# 数据库文件路径（默认：${MYMODELSCOPE_REPO_PATH}\.mymodelscope.db）
MYMODELSCOPE_DB_PATH=

# 扫描排除目录（逗号分隔，支持通配符）
MYMODELSCOPE_SCAN_EXCLUDE=._*,*.tmp,.metadata-only

# ─── 模型源 API 密钥（用于查询元数据和下载模型）───
# HuggingFace Hub Token（在 https://huggingface.co/settings/tokens 创建）
HF_TOKEN=

# CivitAI API Key（在 https://civitai.com/user/account 创建）
CIVITAI_API_KEY=

# ModelScope 访问令牌（在 https://modelscope.cn/my/overview 创建）
MODELSCOPE_ACCESS_TOKEN=
