#!/bin/bash
# Skill Market — post-commit hook (路径 C 落地,2026-08-14 v3,D-7 切新路径 2026-08-21)
#
# 触发时机: git commit 成功之后
# 职责: 把本次 commit 期间产生的跨会话经验沉淀到全局 user-self-improving
#        兜底 §5.3 推荐组合中的 C 路径
#
# 设计原则(对照 .trae/rules/learning.md §5):
#   - 不阻断 commit(已 commit 成功,失败仅 warn)
#   - 探测式降级(user-self-improving 不存在时静默 skip)
#   - 优先级: 全局 PATH → node 探测 → 仓库内 shim
#   - 用 bash 数组存命令,正确处理带空格路径(node.exe 可能在 C:\Program Files\)
#   - 把 stdout/stderr 全部丢 logs/,不污染 commit 输出
#
# D-7 迁移(2026-08-21):
#   - 旧 env `SELF_IMPROVING_HOME` + 旧路径 `.self-improving-agent` 已彻底废弃
#   - 仅认 `USER_SELF_IMPROVING_HOME` env + `.user-self-improving` 路径
#   - 命令名仍是 `self-improving-agent`(命令行向后兼容)

set +e   # 关键:任何失败都不影响 commit 状态

LOG_DIR="logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/post-commit-self-improve.log"

echo "[post-commit] self-improving-agent 兜底启动 ($(date +%Y-%m-%dT%H:%M:%S))" >> "$LOG_FILE"

# 1. 探测 self-improving-agent CLI
#    用 bash 数组存命令,正确处理带空格路径
declare -a SIA_CMD
if command -v self-improving-agent >/dev/null 2>&1; then
  SIA_CMD=("self-improving-agent")
elif [ -f "scripts/self-improving-agent.mjs" ]; then
  # 探测 node 路径(WSL bash / Git Bash 都不在默认 PATH)
  # 优先级: PATH → where.exe → WSL 风格硬编码路径
  NODE_BIN="$(command -v node 2>/dev/null || true)"
  if [ -z "$NODE_BIN" ] && command -v where.exe >/dev/null 2>&1; then
    # where.exe 返回 Windows 路径(如 C:\Program Files\nodejs\node.exe)
    WIN_NODE="$(where.exe node 2>/dev/null | head -n 1 | tr -d '\r' || true)"
    if [ -n "$WIN_NODE" ]; then
      # 转换: C:\Program Files\...  →  /mnt/c/Program Files/...
      # 也支持 Git Bash 的 /c/... 格式
      if [[ "$WIN_NODE" =~ ^([A-Za-z]):\\(.*)$ ]]; then
        DRIVE_LOWER="$(echo "${BASH_REMATCH[1]}" | tr '[:upper:]' '[:lower:]')"
        REST="${BASH_REMATCH[2]//\\//}"
        NODE_BIN="/mnt/${DRIVE_LOWER}/${REST}"
      fi
    fi
  fi
  if [ -z "$NODE_BIN" ] && [ -f "/mnt/c/Program Files/nodejs/node.exe" ]; then
    NODE_BIN="/mnt/c/Program Files/nodejs/node.exe"
  fi
  if [ -z "$NODE_BIN" ]; then
    echo "[post-commit] skip: 仓库内 shim 存在但找不到 node(node 未装或 PATH 异常)" >> "$LOG_FILE"
    exit 0
  fi
  SIA_CMD=("$NODE_BIN" "scripts/self-improving-agent.mjs")
else
  echo "[post-commit] skip: self-improving-agent 不在 PATH 且仓库内 shim 缺失" >> "$LOG_FILE"
  exit 0
fi
echo "[post-commit] resolved: SIA=${SIA_CMD[*]}" >> "$LOG_FILE"

# 2. 探测全局 LEARNING 目录
#    shim 在 Windows 原生 node 跑,读 Windows 路径 — 需把 WSL 路径转换
#    关键: $HOME 在 WSL root 下是 /root,不是 Windows 用户家目录
#    改用 USERPROFILE 翻译 或硬编码 Windows 路径探测
SIA_HOME_LINUX="${USER_SELF_IMPROVING_HOME:-$HOME/.user-self-improving}"
# 1) 优先用 USERPROFILE 转换
if [ -n "$USERPROFILE" ]; then
  SIA_HOME_LINUX="$(cygpath -u "$USERPROFILE" 2>/dev/null || echo "$USERPROFILE")/.user-self-improving"
fi
# 2) 还是 /root 这种 WSL 默认,直接用 Windows 用户家目录
if [[ "$SIA_HOME_LINUX" =~ ^/root/?$ ]] || [[ "$SIA_HOME_LINUX" == *"/root/.user-self-improving" ]]; then
  SIA_HOME_LINUX="/mnt/c/Users/septe/.user-self-improving"
fi
# 3) /mnt/c/... → C:\... 翻译
if [[ "$SIA_HOME_LINUX" =~ ^/mnt/([a-z])/(.*)$ ]]; then
  DRIVE_UPPER="$(echo "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')"
  REST="${BASH_REMATCH[2]//\//\\}"
  SIA_HOME_WIN="${DRIVE_UPPER}:\\${REST}"
else
  SIA_HOME_WIN="$SIA_HOME_LINUX"
fi
echo "[post-commit] HOME: linux=$SIA_HOME_LINUX → win=$SIA_HOME_WIN" >> "$LOG_FILE"
if [ ! -d "$SIA_HOME_LINUX" ] && [ ! -d "$SIA_HOME_WIN" ]; then
  echo "[post-commit] init: $SIA_HOME_WIN 不存在,shim 首次跑会创建" >> "$LOG_FILE"
fi

# 3. 调用 reflect:把上一次 commit 期间的 commit 信息落盘
COMMIT_SHA="$(git rev-parse HEAD 2>/dev/null)"
if [ -z "$COMMIT_SHA" ]; then
  echo "[post-commit] skip: 无法解析 HEAD" >> "$LOG_FILE"
  exit 0
fi

# --since <commit>: 只回放本次 commit 之前未持久化的会话级 hint
# --auto: 非交互,自动合并重复条目
# --quiet: 静默,只输出错误
# --home: WSL 调 Windows native node 时 env 不透传,改用 CLI
"${SIA_CMD[@]}" --home "$SIA_HOME_WIN" reflect \
  --since "$COMMIT_SHA~1" \
  --auto \
  --quiet \
  >> "$LOG_FILE" 2>&1

RC=$?
if [ $RC -ne 0 ]; then
  echo "[post-commit] warn: user-self-improving reflect 退出码 $RC(不阻断 commit)" >> "$LOG_FILE"
fi

echo "[post-commit] 完成 (rc=$RC)" >> "$LOG_FILE"
exit 0
