#!/bin/bash
# Skill Market L1 Commit Gate
#
# 触发时机: git commit
# 检查项（必须全部执行,失败即阻断）:
#   - Lint (node --check 所有 JS 文件)
#   - Unit Tests (skill-change-control / skill-install-control / dependency-guard / structure-guard / security-guard)
#   - 技能安全守卫（仅变更的技能）
#   - 技能结构守卫（仅新建技能）

set -e

echo "🔍 执行 L1 Commit Gate..."

# 1. Lint（必须存在）
if ! grep -q '"lint"' package.json; then
  echo "❌ Gate 配置错误: package.json 缺少 lint 脚本"
  exit 1
fi
echo "1️⃣ Lint..."
npm run lint

# 2. Unit Tests（必须存在）
if ! grep -q '"test:unit"' package.json; then
  echo "❌ Gate 配置错误: package.json 缺少 test:unit 脚本"
  exit 1
fi
echo "2️⃣ Unit Tests..."
npm run test:unit

# 3. 技能安全守卫（仅变更的技能目录）
CHANGED_SKILLS=$(git diff --name-only --cached | grep '^skill-markets/' | awk -F/ '$2 && $2 !~ /\.md$/ {print $2}' | sort -u)
if [ -n "$CHANGED_SKILLS" ]; then
  echo "3️⃣ 技能安全守卫..."
  for skill in $CHANGED_SKILLS; do
    if [ -d "skill-markets/$skill" ]; then
      echo "  - $skill"
      python scripts/skill-security-guard.py "skill-markets/$skill"
    fi
  done
fi

# 4. 技能结构守卫（仅新建技能目录）
NEW_SKILLS=$(git diff --name-only --cached --diff-filter=A | grep '^skill-markets/[^/]*/SKILL\.md$' | awk -F/ '{print $2}' | sort -u)
if [ -n "$NEW_SKILLS" ]; then
  echo "4️⃣ 技能结构守卫..."
  for skill in $NEW_SKILLS; do
    if [ -d "skill-markets/$skill" ]; then
      echo "  - $skill"
      python scripts/skill-structure-guard.py "skill-markets/$skill"
    fi
  done
fi

echo "✅ L1 Commit Gate 通过"