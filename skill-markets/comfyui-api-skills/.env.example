# =============================================================================
# ComfyUI 中文版技能包 — 环境变量示例
# =============================================================================
# 复制为 .env 后填入真实值。skill 在执行时会优先读取这些变量，未设置时
# 使用方括号 [] 中的默认值。所有路径在 Windows 上使用双反斜杠或在引号内
# 使用单反斜杠。
# =============================================================================

# ---- ComfyUI 服务连接 -------------------------------------------------------
# 默认本地服务地址。远程实例填 http://<host>:<port>
COMFYUI_URL=http://127.0.0.1:8188

# 接口调用超时（秒）。生成轮询不受此限。
COMFYUI_API_TIMEOUT=30

# 轮询间隔（秒）。视频生成建议 10-15s。
COMFYUI_POLL_INTERVAL=5

# 轮询最长等待（秒）。超过后提示用户。
COMFYUI_POLL_TIMEOUT=600

# ---- ComfyUI 安装路径（离线扫描用）----------------------------------------
# 留空则跳过离线扫描，必须在线调用 /object_info
COMFYUI_INSTALL_DIR=C:\ComfyUI

# ---- 硬件上下文（用于模型推荐与显存决策）-----------------------------------
# GPU 型号（自由文本）
GPU_MODEL=RTX 3090 Ti
# 显存（GB）
GPU_VRAM_GB=24
# 启动参数
COMFYUI_LAUNCH_FLAGS=--listen 0.0.0.0 --preview-method latent2rgb --enable-manager

# ---- 客户端标识 ------------------------------------------------------------
# 提交工作流时使用的 client_id
COMFYUI_CLIENT_ID=comfyui-api-skills

# ---- 模型知识库联网补全 ---------------------------------------------------
# HuggingFace：免 key 也能用（限速低），有 key 限速更高
# 在 https://huggingface.co/settings/tokens 申请
HF_TOKEN=
# CivitAI：强烈建议填 key（公开 API 限速很严）
# 在 https://civitai.com/user/account 申请
CIVITAI_API_KEY=

# ---- 输出目录（可选）-------------------------------------------------------
# 生成结果下载到哪里。留空保持 ComfyUI 默认（output/）。
OUTPUT_DIR=

# ---- 发布平台凭证（video-publisher 使用）------------------------------------
# 见 video-publisher/SKILL.md 的详细说明
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
