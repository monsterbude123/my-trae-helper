{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trae.local/schemas/state-card.schema.json",
  "title": "V11 State Card Schema",
  "description": "V11.8.7 NEW (case 2 蒸馏 fix 文档 vs 实现漂移):状态卡 frontmatter 唯一真相源。文档(state-card-protocol.md)+ 脚本(state-card-validator.py / stage-gate.py)+ 模板(templates/state-card.md) 都从此 schema 校验/生成。任何字段名/合法值/必填状态变更 = 先改本文件,再 sync。",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "card_type",
    "card_id",
    "version",
    "current_stage",
    "stage_status",
    "stage_started_at",
    "updated_at",
    "updated_by",
    "health",
    "artifacts",
    "gate_result",
    "next_stage",
    "actor",
    "duration_minutes",
    "notes"
  ],
  "properties": {
    "card_type": {
      "type": "string",
      "enum": ["project", "change", "bug"],
      "description": "状态卡类别"
    },
    "card_id": {
      "type": "string",
      "description": "项目名/change-id/bug-id"
    },
    "version": {
      "type": "string",
      "description": "语义版本号"
    },
    "current_stage": {
      "type": "string",
      "enum": [
        "-1/intake", "0/plan", "0.5/test-plan", "1/spec", "1.5/prototype",
        "2/contract", "3/implement", "3.5/real-verify", "4/review",
        "4.5/rot-scan", "5/accept", "6/bug-fix", "7/health"
      ],
      "description": "当前 stage,V11 13 stage 之一"
    },
    "stage_status": {
      "type": "string",
      "enum": ["pending", "working", "completed", "blocked", "skipped"],
      "description": "当前 stage 状态"
    },
    "stage_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601"
    },
    "stage_ended_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601,stage_status=completed 时必填"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601,陈旧阈值 30 分钟"
    },
    "updated_by": {
      "type": "string",
      "description": "主上下文 | sub-agent name(只读权限)"
    },
    "health": {
      "type": "string",
      "enum": ["🟢 on-track", "🟡 degraded", "🔴 blocked"],
      "description": "项目/change/bug 健康度"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^path:.*- exists:(true|false) - evidence:.*$"
      },
      "description": "stage 产物清单,格式: 'path: <path> - exists: <bool> - evidence: <file:line or cmd>'"
    },
    "visual_evidence": {
      "type": "object",
      "description": "V11.2 NEW Stage 3.5 → 4 硬门槛",
      "required": ["status", "screenshots", "verified_at"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["verified", "unverified", "skipped"]
        },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "contains_change_components", "interactive_proof", "read_by_main_context"],
            "properties": {
              "path": {"type": "string"},
              "contains_change_components": {"type": "boolean"},
              "interactive_proof": {"type": "string"},
              "read_by_main_context": {"type": "boolean", "description": "主上下文亲自 Read PNG 标志,禁止 AI 描述"}
            }
          }
        },
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "failure_action": {"type": "string"}
      }
    },
    "gate_result": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "N/A", "PENDING"]
        },
        "gate": {"type": "string", "description": "门禁脚本名"},
        "output": {"type": ["string", "null"], "description": "门禁输出片段"},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "next_stage": {
      "type": "object",
      "description": "下一 stage 路由信息",
      "properties": {
        "id": {"type": "string", "description": "stage id,如 3/implement"},
        "skill_name": {"type": "string"},
        "expected_inputs": {"type": "array", "items": {"type": "string"}},
        "prerequisites": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    },
    "blocked_by": {
      "type": ["object", "null"],
      "description": "阻塞报告(5 字段),或 null"
    },
    "actor": {"type": "string"},
    "duration_minutes": {"type": "integer", "minimum": 0},
    "parent_change": {"type": ["string", "null"], "description": "子 change 必填指向父 change id"},
    "related_changes": {"type": "array", "items": {"type": "string"}},
    "bug_id": {"type": ["string", "null"]},
    "bug_severity": {
      "type": ["string", "null"],
      "enum": ["P0", "P1", "P2", "P3", null],
      "description": "仅 card_type=bug 时必填"
    },
    "risk_level": {
      "type": "string",
      "enum": ["LOW", "MEDIUM", "HIGH"]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "notes": {"type": "string"},
    "reset_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "from_stage", "to_stage", "reason", "reset_by"],
        "properties": {
          "date": {"type": "string", "format": "date-time"},
          "from_stage": {"type": "string"},
          "to_stage": {"type": "string"},
          "reason": {"type": "string"},
          "preserved_artifacts": {"type": "array", "items": {"type": "string"}},
          "removed_artifacts": {"type": "array", "items": {"type": "string"}},
          "archive_note": {"type": "string"},
          "git_decision": {"type": "string"},
          "reset_by": {"type": "string"}
        }
      }
    }
  },
  "allOf": [
    {
      "description": "P0-2 P1-2 联动:stage_status=completed → stage_ended_at 必填",
      "if": {
        "properties": {"stage_status": {"const": "completed"}}
      },
      "then": {
        "required": ["stage_ended_at"],
        "properties": {
          "stage_ended_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    {
      "description": "card_type=bug → bug_severity 必填 P0-P3",
      "if": {
        "properties": {"card_type": {"const": "bug"}}
      },
      "then": {
        "required": ["bug_severity"],
        "properties": {
          "bug_severity": {"enum": ["P0", "P1", "P2", "P3"]}
        }
      }
    },
    {
      "description": "current_stage = 3.5/real-verify 或 4/review → visual_evidence.status = verified",
      "if": {
        "anyOf": [
          {"properties": {"current_stage": {"const": "3.5/real-verify"}}},
          {"properties": {"current_stage": {"const": "4/review"}}}
        ]
      },
      "then": {
        "properties": {
          "visual_evidence": {
            "required": ["status"],
            "properties": {
              "status": {"const": "verified"}
            }
          }
        }
      }
    }
  ],
  "_meta": {
    "v11_8_7_authoritative": true,
    "consumers": [
      "scripts/state-card-validator.py (字段必填 + 合法性 + 联动约束)",
      "scripts/stage-gate.py (state_card fields 提取)",
      "references/state-card-protocol.md (字段定义 §2)",
      "templates/state-card.md (模板)",
      "scripts/setup-feature.py (创建骨架)",
      "scripts/change-status.py (字段写入)"
    ],
    "any_field_change_procedure": "1. 改本 JSON 2. 跑 state-card-validator.py 校验 3. 同步 state-card-protocol.md §2 4. 重跑 unittests"
  }
}
