{
  "hooks": {
    "SessionStart": [
      {
        "name": "fullstack-project-context",
        "enabled": true,
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/session-start.ps1"
      }
    ],
    "UserPromptSubmit": [
      {
        "name": "fullstack-complexity-guard",
        "enabled": false,
        "matcher": "",
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/complexity-guard.ps1"
      }
    ],
    "PreToolUse": [
      {
        "name": "fullstack-doc-sync-gate",
        "enabled": true,
        "matcher": "Write|Edit",
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/doc-sync-gate.ps1"
      },
      {
        "name": "fullstack-contract-gate",
        "enabled": true,
        "matcher": "Write|Edit",
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/contract-gate.ps1"
      }
    ],
    "PostToolUse": [
      {
        "name": "fullstack-spec-validate",
        "enabled": true,
        "matcher": "Write",
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/spec-validate-hook.ps1"
      },
      {
        "name": "fullstack-auto-test",
        "enabled": true,
        "matcher": "Edit|Write",
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/auto-test.ps1"
      },
      {
        "name": "fullstack-drift-detect",
        "enabled": true,
        "matcher": "Edit|Write",
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/drift-detect.ps1"
      }
    ],
    "Stop": [
      {
        "name": "fullstack-tasks-integrity",
        "enabled": true,
        "command": "powershell -ExecutionPolicy Bypass -File .trae/hooks/tasks-integrity.ps1"
      }
    ]
  }
}
