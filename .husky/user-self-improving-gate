#!/bin/bash
# .husky/user-self-improving-gate — user-self-improving L1 Commit Gate (2026-08-21 guard-smith 委派落地)
#
# 触发时机: git commit (由 .husky/pre-commit 调用) / 手动 `bash .husky/user-self-improving-gate`
# 门禁项:
#   1. user-self-improving 6 项薄壳守卫(SKILL.md / assets / references / scripts 齐全 + bash -n 通过 + hooks/ 已删除)
#   2. 仅对 staged 修改过的 user-self-improving 触发(优化 pre-commit 性能)
#   3. 仅 guard-smith agent 可改本文件 + scripts/user-self-improving-guard.py(AGENTS.md §1.11)
#
# 跨平台 Python 探测: 复用 scripts/detect-python.sh(详见 AGENTS.md §4.1.3)
#                    不硬编码任何具体路径,只信 PATH + 能力校验

# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/detect-python.sh" || exit 1
PY="$MY_TRAE_HELPER_PY"

# PowerShell 调 bash 子进程时, stdout 句柄可能被父进程 pipe 截断
exec 1>&2
set -e

echo "🔍 执行 user-self-improving L1 Gate (PY=$PY)..."

# 探测是否触及 user-self-improving 相关文件 — 仅在改动时才跑守卫,避免无意义开销
CHANGED=$(git diff --name-only --cached 2>/dev/null | grep -E '^skill-markets/user-self-improving/' || true)
if [ -z "$CHANGED" ]; then
    echo "ℹ️  本次 commit 未触及 user-self-improving 相关文件,跳过守卫"
    echo "✅ user-self-improving L1 Gate 通过(无变更)"
    exit 0
fi

echo "📋 改动文件 ($(echo "$CHANGED" | wc -l) 项):"
echo "$CHANGED" | sed 's/^/  - /'

# 跑专属守卫(项目侧薄壳)
echo ""
echo "  ▶ $PY scripts/user-self-improving-guard.py user-self-improving"
if ! "$PY" scripts/user-self-improving-guard.py user-self-improving; then
    echo ""
    echo "❌ user-self-improving L1 Gate BLOCK:守卫返回非 0"
    echo "   修复指引:"
    echo "     - SKILL.md frontmatter 缺字段:补 name + description(AGENTS.md §1 铁律)"
    echo "     - SKILL.md 行数超 350:提取 references/ 子目录(vibe-coding-standards v2.5)"
    echo "     - assets 缺失:补 LEARNINGS.md / ERRORS.md / FEATURE_REQUESTS.md / SOUL.md / TOOLS.md / MEMORY.md / SKILL-TEMPLATE.md"
    echo "     - references 缺失:补 10 项 references/* 文档(含 legacy-openclaw-handler.md)"
    echo "     - scripts 缺失或语法错:补全 5 项 + bash -n 校验"
    echo "     - hooks/ 目录残留:删除 hooks/ 目录(已搬到 references/legacy-openclaw-handler.md)"
    exit 1
fi

echo ""
echo "✅ user-self-improving L1 Gate 通过"
