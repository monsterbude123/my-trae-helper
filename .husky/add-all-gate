#!/bin/bash
# .husky/add-all-gate — add-all CLI 命令专属 L1 Commit Gate (2026-08-18 NEW)
#
# 触发时机: 仅当改动触及 add-all CLI 实现时(git diff --name-only --cached)
#   - src/add-all.mjs
#   - bin/cli.mjs
#   - tests/unit/test_add_all.mjs
#
# 门禁项:
#   1. scripts/add-all-guard.py add-all — 验证 src 语法 + CLI 注册 + 单元测试
#
# 跨平台 Python 探测: 复用 scripts/detect-python.sh(不硬编码路径,见 AGENTS.md §4.1.3)

# shellcheck disable=SC1091
. "$(dirname "$0")/../scripts/detect-python.sh" || exit 1
PY="$MY_TRAE_HELPER_PY"

# PowerShell 调 bash 子进程时,stdout 句柄可能被父进程 pipe 截断
exec 1>&2
set -e

echo "🔍 执行 add-all L1 Gate (PY=$PY)..."

# 探测是否触及 add-all 相关文件 — 仅在改动时才跑守卫,避免无意义开销
CHANGED=$(git diff --name-only --cached 2>/dev/null | grep -E '^(src/add-all\.mjs|bin/cli\.mjs|tests/unit/test_add_all\.mjs)$' || true)
if [ -z "$CHANGED" ]; then
  echo "ℹ️  本次 commit 未触及 add-all 相关文件,跳过守卫"
  exit 0
fi

echo "📋 改动文件: $(echo "$CHANGED" | tr '\n' ' ')"

# 跑专属守卫
"$PY" scripts/add-all-guard.py add-all

echo "✅ add-all L1 Gate 通过"